#!/usr/bin/env python3
"""Detect whether a 78rpm record image is a full-disc photo or a label-only scan.

A 10" shellac disc carries a ~3.25" paper label, so on a *full-disc* photo the
label circle radius is only ~0.30-0.40 of the disc radius and the disc itself
nearly fills the frame -- the label is a bright/coloured island surrounded by a
wide ring of dark shellac. On a *label-only* scan the label fills the frame
(radius >= ~0.42 of the min dimension) and often touches the edges.

``classify_and_detect`` finds a roughly-centred label circle from a "labelness"
map (bright OR saturated pixels), then corroborates ``full_disc`` by checking the
band just outside the candidate label is dark shellac. It is deliberately
conservative: when signals conflict it returns ``unknown`` and never crops.

A disc photographed on a *white/light backdrop* breaks the primary labelness map:
the near-white surround is by far the brightest thing in the frame, so Otsu splits
"backdrop vs disc" and everything on the disc -- label included -- lands on the
dark side. The only mask component left is the backdrop, which is a RING around
the disc. A ring's centroid is exactly the frame centre and its enclosing circle
spans the whole frame, so a naive "nearest to centre" pick called these photos
``label_only``. Two defences: a component must *cover* the centre (which a ring
cannot), and when the primary map yields no verdict we retry with backdrop-aware
labelness maps (see ``_alt_label_maps``).

Every path above separates label from shellac by COLOUR -- bright paper or
saturated ink against dark, desaturated shellac. That premise fails outright on a
*dark* label: Odeon's brown/black and RCA Victor's near-black labels with light
text are neither bright nor saturated, so ``max(V, S)`` never isolates them and
no component owns the centre. Measured over the 218 delivered harvest crops, 37
of the 69 ``unknown`` verdicts failed exactly this way, and the
``_INNER_OVER_RING`` guard is structurally unable to help -- it *requires* the
label to be ~28 V brighter than the shellac, which for these discs is false.

``_texture_label_radius`` supplies a third, brightness-independent path. A record
label is printed matter: at the working resolution its text and ornament carry
strong fine detail, while shellac -- whose grooves are far below this scale and
very low contrast -- is smooth. So the radial profile of high-frequency energy is
high across the label and *collapses* to near zero the moment it crosses onto the
shellac, and the radius of that collapse IS the label radius. Measured on real
full-disc photos the ratio is stark (peak 15-25 inside, 0.3-2.5 outside); on a
label-only scan the profile never collapses, because print covers the whole
frame. This is why it reads dark labels the colour paths cannot see, and why its
verdict is trusted over a ``label_only`` from the primary map: a full disc whose
glare band inflates the primary component is exactly the case the colour paths
mis-size.
"""
from __future__ import annotations

import sys

import cv2
import numpy as np
from PIL import Image

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")
    sys.stderr.reconfigure(encoding="utf-8")

WORK_DIM = 800          # detection resolution (long edge)
CROP_MARGIN = 0.04      # extra margin around the label circle when cropping

# --- tuned on a 64-image ground-truth sample (DAHR full-disc; DiSarli/TangoInfo/
# --- Discogs label-only). Goal: zero false 'full_disc' on true label-only scans.
_LABEL_ONLY_RFRAC = 0.42    # label circle >= this fraction of min-dim -> fills frame
_FULL_MAX_RFRAC = 0.40      # candidate label must be smaller than this to be a disc
_FULL_MIN_RFRAC = 0.13      # ... and larger than this (smaller = logo/noise)
_DARK_V = 85                # shellac is dark: V below this counts as shellac
_RING_DARK_FRAC = 0.60      # >= this fraction of the outer band must be dark shellac
_INNER_OVER_RING = 28       # label interior must be this much brighter than the band
_MAX_CENTER_OFF = 0.16      # label centre offset from frame centre (fraction of min-dim)
# The corroborating shellac band must be a real ring, not a sliver. r_out is
# capped at 0.48 of min-dim, so for a candidate label at the _FULL_MAX_RFRAC
# ceiling the band collapses to [0.46, 0.48] -- which on a SQUARE image lies
# almost entirely in the four corners. On an already-cropped label those corners
# hold the last of the shellac, so the band reads "dark" and the crop was judged
# a full disc a second time. That made cropping non-idempotent: a re-run clipped
# print off an image the first run had framed correctly (measured on Gardel's
# 1933 Milonga Sentimental). Demanding a genuinely wide ring is the same
# geometric argument as _TEX_MIN_RING_RATIO and effectively caps the usable
# label radius at 0.48/1.5 = 0.32 of min-dim.
_MIN_RING_SPAN = 1.5
_FLAT_DARK_V = 70           # whole frame this dark & low-contrast -> unknown (dark label)
_BLOWN_FRAC = 0.55          # interior this fraction blown-white -> specular highlight
_NSECTORS = 12              # angular sectors of the outer band to check
_MIN_DARK_SECTORS = 10      # shellac surrounds the label ~360 deg: this many must be dark

# --- centre-ownership probe. A 78's spindle hole is ~7mm across on an ~83mm
# --- label, i.e. radius ~0.042 of the frame on a label-only scan; a probe disk of
# --- radius 0.06 is therefore still >=0.5 covered by the label around such a hole,
# --- while a backdrop ring covers exactly 0 of it.
_CORE_RFRAC = 0.06          # radius of the central probe disk (fraction of min-dim)
_CORE_COVER = 0.25          # component must own this much of the probe disk
# 0.25 is empirical, not just geometric: measured over the maintainer's ~1200
# delivered label scans it is the loosest value that yields zero false 'full_disc'
# (0.15 lets a wide-margin Di Sarli scan through). Scans that miss it fall to
# 'unknown', which crops nothing -- the same outcome as 'label_only'.

# --- backdrop suppression (alternate maps only): the light surround a disc is
# --- photographed on is bright, desaturated and connected to the frame border.
_BACKDROP_V = 200           # backdrop is at least this bright ...
_BACKDROP_S = 60            # ... and no more saturated than this
_BACKDROP_MIN_FRAC = 0.02   # ignore specks: too small to be skewing Otsu
_BACKDROP_MAX_FRAC = 0.75   # more than this and we are not looking at a disc photo
_SAT_MIN_THR = 45           # Otsu floor for the saturation-only map (shellac S ~15)

# A 10" disc carries a ~3.25" label, so a disc that FITS IN THE FRAME puts the
# label radius at ~0.325 * 0.5 = 0.16 of min-dim; 0.26 leaves room for tilt and
# for discs that overflow the frame a little. Anything larger is a close-up of the
# label, not a full disc -- which is how a wide-margin label scan sneaks past the
# generic _FULL_MAX_RFRAC. Applied to the retry path only, so it cannot cost the
# primary path any of its tuned detections.
_ALT_MAX_RFRAC = 0.26

# --- Hough fallback. CANDIDATE GENERATION ONLY: every circle it proposes is
# --- still vetted by _full_disc_bbox, so the dark-shellac ring, the sector
# --- wrap and the label/ring contrast all still have to hold. It is reached
# --- only after every colour and texture path above has failed, so it cannot
# --- change a detection the tuned paths already make -- it can only turn an
# --- 'unknown' (which costs the caller the crop entirely, handing the vision
# --- pass a whole uncropped frame) into a vetted crop.
# NOT lowered below _FULL_MIN_RFRAC. That floor is load-bearing: on a
# label-only scan Hough happily locks onto a small printed inner ring, whose
# surrounding dark INK then satisfies the shellac-ring, sector and contrast
# guards (measured: rfrac 0.119, dark_frac 0.94, 12/12 sectors, +35 contrast --
# a clean false positive). Edge-based candidates buy us off-centre and
# low-fill discs, not smaller ones.
_HOUGH_MIN_RFRAC = _FULL_MIN_RFRAC
_HOUGH_MAX_RFRAC = 0.40     # same ceiling as the generic full-disc bar
_HOUGH_CENTER_OFF = 0.34    # a disc laid off-centre on a seller's table
_HOUGH_EDGE = 100           # Canny high threshold for the gradient stage
_HOUGH_ACC = 30             # accumulator bar; lower finds more, vetting is unchanged
_HOUGH_MAX_CANDIDATES = 6   # best-accumulator-first, so this is a cost bound
# Shellac-reach corroboration, required of Hough candidates only. A 10" disc
# carries a ~3.25" label, so real shellac runs out to ~3x the label radius. On
# a label-only scan a bogus inner circle has dark INK just outside it but paper
# or scan margin further out, and ink is not desaturated the way shellac is.
_REACH_OUT = 3.0            # corroborate shellac out to this multiple of r ...
_REACH_FROM = 2.2           # ... starting beyond the near band already checked
_REACH_MAX_FRAC = 0.49      # clipped to the frame
_REACH_DARK = 0.60          # fraction of the far band that must be dark
_REACH_SAT = 70.0           # ... and its mean saturation must stay below this

# --- texture-collapse path (see module docstring). Tuned on the 218 delivered
# --- harvest crops and validated against an 800-image random sample of the
# --- ~5,700 served label scans, where it fired on 19 and all 19 were genuine
# --- full-disc photos -- zero false positives.
_TEX_NBINS = 50             # radial bins from the centre out to _TEX_PROF_RMAX
_TEX_PROF_RMAX = 0.5        # profile reach (fraction of min-dim; 0.5 = frame edge)
_TEX_FINE_SIGMA = 1.2       # high-pass scale: detail finer than this is "print"
_TEX_POOL_SIGMA = 3.0       # pooling scale, so one glyph does not make a bin
_TEX_ALPHA = 0.22           # "quiet" = below this fraction of the in-label peak
_TEX_RMIN = 0.13            # label-radius search floor ...
_TEX_RMAX = 0.30            # ... and ceiling (a larger radius is a label close-up)
_TEX_QUIET_TO = 0.45        # the quiet band must hold out to here: a real shellac
                            # ring is WIDE. A label that merely fills most of the
                            # frame goes quiet only near the corners and so cannot
                            # satisfy this, which is what keeps tight label scans
                            # (and the 0.35-collapse cases) out of the crop set.
_TEX_MIN_PEAK = 3.0         # below this the frame carries no print at all; the
                            # ratio test on near-zero noise would be meaningless
_TEX_MIN_BIN_PX = 20        # pixels needed before a bin's mean is trusted

# The shellac ring must be WIDE RELATIVE TO THE LABEL, not merely wide. A 10"
# disc carries a 3.25" label, so on a disc that fills the frame the ring runs
# from the label edge out to roughly 3x the label radius. A close-up whose label
# already spans ~0.28 of the frame cannot have that much ring left, and cropping
# it is the risky case: it is a usable label image already, and re-cropping only
# trades margin for the chance of clipping print.
#
# 1.7 is where the measured populations separate. It costs one of the 54 matched
# harvest crops and 7 of 19 served-library candidates -- all of them wide-margin
# close-ups, all of which simply fall back to 'unknown' and are left untouched --
# and it is what keeps the deliberate wide-margin label scans in the test corpus
# (see LABEL_ONLY) from being cropped. Recall here is worth less than the
# guarantee that an already-good label scan is never re-cropped.
_TEX_MIN_RING_RATIO = 1.7

Verdict = str  # 'full_disc' | 'label_only' | 'unknown'
BBox = tuple[int, int, int, int]  # (left, top, right, bottom) in original pixels


def _to_bgr(img) -> np.ndarray:
    """Accept a PIL image or an RGB/BGR numpy array; return an 8-bit BGR array."""
    if isinstance(img, Image.Image):
        return cv2.cvtColor(np.asarray(img.convert("RGB")), cv2.COLOR_RGB2BGR)
    arr = np.asarray(img)
    if arr.ndim == 2:
        return cv2.cvtColor(arr, cv2.COLOR_GRAY2BGR)
    if arr.ndim == 3 and arr.shape[2] == 4:
        arr = arr[:, :, :3]
    return np.ascontiguousarray(arr[:, :, ::-1]) if arr.shape[2] == 3 else arr


def _downscale(bgr: np.ndarray) -> tuple[np.ndarray, float]:
    """Downscale to WORK_DIM long edge; return (work, scale) where orig = work/scale."""
    h, w = bgr.shape[:2]
    s = WORK_DIM / max(h, w)
    if s >= 1.0:
        return bgr, 1.0
    return cv2.resize(bgr, (max(1, round(w * s)), max(1, round(h * s))),
                      interpolation=cv2.INTER_AREA), s


def _central_component(mask: np.ndarray, reject_border: bool = False) -> np.ndarray | None:
    """Return the mask component that *owns* the frame centre, else ``None``.

    Ownership is measured as the share of a small central probe disk the component
    covers, not by centroid proximity: a bright backdrop surrounding a disc is a
    ring whose centroid is dead-centre but which covers none of the probe disk, so
    it can never masquerade as the label. A dark spindle hole or dark label centre
    -- the reason this tolerates the centre pixel being off -- only punches a small
    hole in the probe disk, so a genuine label still clears ``_CORE_COVER``.

    ``reject_border`` additionally drops components running into the frame edge.
    Only the full-disc search may set it: on a true label-only scan the label
    legitimately touches the border.
    """
    n, lbl, stats, _ = cv2.connectedComponentsWithStats(mask, 8)
    if n <= 1:
        return None
    h, w = mask.shape
    core = lbl[_disk_mask(h, w, w / 2, h / 2, min(h, w) * _CORE_RFRAC)]
    if core.size == 0:
        return None
    best, best_key = None, (_CORE_COVER, 0)
    for i in range(1, n):
        if reject_border and _touches_border(stats[i], h, w):
            continue
        key = (float((core == i).mean()), int(stats[i, cv2.CC_STAT_AREA]))
        if key[0] >= _CORE_COVER and key > best_key:
            best, best_key = i, key
    return (lbl == best).astype(np.uint8) * 255 if best is not None else None


def _touches_border(stat: np.ndarray, h: int, w: int) -> bool:
    x, y, ww, hh = (int(stat[cv2.CC_STAT_LEFT]), int(stat[cv2.CC_STAT_TOP]),
                    int(stat[cv2.CC_STAT_WIDTH]), int(stat[cv2.CC_STAT_HEIGHT]))
    return x <= 0 or y <= 0 or x + ww >= w or y + hh >= h


def _binarise(m: np.ndarray, floor: float) -> np.ndarray:
    """Otsu-threshold a labelness map (with a floor) and clean it up morphologically."""
    otsu, _ = cv2.threshold(np.clip(m, 0, 255).astype(np.uint8), 0, 255,
                            cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    mask = (m > max(float(otsu), floor)).astype(np.uint8) * 255
    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, k)
    return cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k)


def _backdrop(V: np.ndarray, S: np.ndarray) -> np.ndarray | None:
    """The bright, desaturated, border-connected surround a disc was shot on.

    ``None`` when no such region is usable -- in particular when it reaches the
    frame centre, which means we are looking at a light label filling the frame
    (a label-only scan on a white scanner bed), not a disc on a backdrop.
    """
    h, w = V.shape
    cand = ((V >= _BACKDROP_V) & (S <= _BACKDROP_S)).astype(np.uint8)
    k = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
    cand = cv2.morphologyEx(cand, cv2.MORPH_CLOSE, k)
    n, lbl, stats, _ = cv2.connectedComponentsWithStats(cand, 8)
    keep = np.zeros((h, w), bool)
    for i in range(1, n):
        if _touches_border(stats[i], h, w):
            keep |= lbl == i
    if keep[h // 2, w // 2] or not (_BACKDROP_MIN_FRAC < keep.mean() < _BACKDROP_MAX_FRAC):
        return None
    return keep


def _alt_label_maps(V: np.ndarray, S: np.ndarray, Lb: np.ndarray,
                    sigma: float) -> list[tuple[np.ndarray, float]]:
    """Labelness maps for the full-disc retry, as ``(map, otsu_floor)`` pairs.

    Both exist because ``max(V, S)`` is useless once a disc is shot on a light
    backdrop: the near-white surround dominates the histogram, so Otsu separates
    backdrop from disc and the label lands on the dark side with the shellac.

    * saturation alone -- a coloured label (RCA Victor blue, HMV red) is the only
      saturated thing in frame; both the white backdrop and the black shellac are
      desaturated, so ``S`` separates them cleanly where ``max(V, S)`` cannot.
    * brightness with the backdrop blanked out -- rescues cream/gold labels that
      are bright but not saturated, by removing the surround from the histogram so
      Otsu splits label from shellac instead of backdrop from disc.

    An opening is not enough here: the label is not merely bridged to the
    backdrop, it is absent from the primary mask entirely.
    """
    maps: list[tuple[np.ndarray, float]] = [
        (cv2.GaussianBlur(S, (0, 0), sigma), _SAT_MIN_THR),
    ]
    bg = _backdrop(V, S)
    if bg is not None:
        no_bg = Lb.copy()
        no_bg[bg] = 0.0
        maps.append((no_bg, 55.0))
    return maps


def _ring_dark_fraction(v: np.ndarray, cx: float, cy: float,
                        r_in: float, r_out: float) -> tuple[float, float]:
    """(dark_fraction, mean_V) of the annulus [r_in, r_out] around (cx, cy)."""
    h, w = v.shape
    yy, xx = np.mgrid[0:h, 0:w]
    rr = np.hypot(xx - cx, yy - cy)
    m = (rr >= r_in) & (rr <= r_out)
    if m.sum() < 30:
        return 0.0, 255.0
    band = v[m]
    return float((band < _DARK_V).mean()), float(band.mean())


def _dark_sector_count(v: np.ndarray, cx: float, cy: float,
                       r_in: float, r_out: float) -> int:
    """How many of _NSECTORS angular wedges of the band are mostly dark shellac.

    A real disc's shellac ring is dark in every direction; a composite image
    (e.g. an LP cover with bright title text) leaves bright wedges and fails.
    """
    h, w = v.shape
    yy, xx = np.mgrid[0:h, 0:w]
    rr = np.hypot(xx - cx, yy - cy)
    ang = np.arctan2(yy - cy, xx - cx) + np.pi
    band = (rr >= r_in) & (rr <= r_out)
    dark = 0
    for s in range(_NSECTORS):
        a0 = s * 2 * np.pi / _NSECTORS
        a1 = (s + 1) * 2 * np.pi / _NSECTORS
        m = band & (ang >= a0) & (ang < a1)
        if m.sum() < 10 or (v[m] < _DARK_V).mean() >= 0.5:
            dark += 1
    return dark


def _label_circle(comp: np.ndarray) -> tuple[float, float, float, float] | None:
    """``(cx, cy, r, fill)`` of a component's minimum enclosing circle."""
    cnts, _ = cv2.findContours(comp, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return None
    cnt = max(cnts, key=cv2.contourArea)
    (cx, cy), r = cv2.minEnclosingCircle(cnt)
    if r < 4:
        return None
    return cx, cy, r, cv2.contourArea(cnt) / (np.pi * r * r + 1e-6)


def _full_disc_bbox(V: np.ndarray, S: np.ndarray, circle, scale: float,
                    H: int, W: int, max_rfrac: float = _FULL_MAX_RFRAC,
                    min_rfrac: float = _FULL_MIN_RFRAC,
                    max_center_off: float = _MAX_CENTER_OFF) -> BBox | None:
    """Vet a candidate label circle as a full-disc photo; return its crop box.

    Every anti-false-positive guard lives here, so a candidate found by any
    labelness map has to clear the same bar.
    """
    cx, cy, r, fill = circle
    h, w = V.shape
    mind = float(min(h, w))
    r_frac = r / mind

    # too small / too big / not roughly round to be a trustworthy label island.
    center_off = np.hypot(cx - w / 2, cy - h / 2) / mind
    if not (min_rfrac <= r_frac <= max_rfrac):
        return None
    if fill < 0.62 or center_off > max_center_off:
        return None

    # corroborate full_disc: a wide DARK shellac band must sit just outside the
    # candidate label, and the label interior must be clearly brighter than it.
    r_out = min(r * 2.2, 0.48 * mind)
    if r_out < r * _MIN_RING_SPAN:
        return None
    dark_frac, ring_v = _ring_dark_fraction(V, cx, cy, r * 1.15, r_out)
    disk = _disk_mask(h, w, cx, cy, r * 0.8)
    inner_v = float(V[disk].mean())
    if dark_frac < _RING_DARK_FRAC or (inner_v - ring_v) < _INNER_OVER_RING:
        return None

    # reject a blown-out specular highlight masquerading as a label: a real label
    # carries printed detail, a reflection is a near-uniform white blob.
    blown = float(((V[disk] >= 245) & (S[disk] <= 25)).mean())
    if blown > _BLOWN_FRAC or (inner_v > 205 and float(V[disk].std()) < 12):
        return None

    # the dark shellac band must wrap the label on (nearly) all sides.
    if _dark_sector_count(V, cx, cy, r * 1.15, r_out) < _MIN_DARK_SECTORS:
        return None

    # square crop around the label at full resolution.
    half = r * (1.0 + CROP_MARGIN)
    left = max(0, int(round((cx - half) / scale)))
    top = max(0, int(round((cy - half) / scale)))
    right = min(W, int(round((cx + half) / scale)))
    bottom = min(H, int(round((cy + half) / scale)))
    if right - left < 8 or bottom - top < 8:
        return None
    return left, top, right, bottom


def _texture_profile(work: np.ndarray) -> np.ndarray:
    """Mean high-frequency energy per radial bin, measured from the frame centre.

    Bins with too few pixels are ``nan`` rather than 0, so a partly out-of-frame
    ring cannot fake a collapse.
    """
    gray = cv2.cvtColor(work, cv2.COLOR_BGR2GRAY).astype(np.float32)
    h, w = gray.shape
    fine = np.abs(gray - cv2.GaussianBlur(gray, (0, 0), _TEX_FINE_SIGMA))
    tex = cv2.GaussianBlur(fine, (0, 0), _TEX_POOL_SIGMA)
    yy, xx = np.mgrid[0:h, 0:w]
    rr = np.hypot(xx - w / 2, yy - h / 2) / float(min(h, w))
    prof = np.full(_TEX_NBINS, np.nan, dtype=np.float64)
    step = _TEX_PROF_RMAX / _TEX_NBINS
    for i in range(_TEX_NBINS):
        m = (rr >= i * step) & (rr < (i + 1) * step)
        if int(m.sum()) >= _TEX_MIN_BIN_PX:
            prof[i] = float(tex[m].mean())
    return prof


def _texture_label_radius(work: np.ndarray) -> float | None:
    """Radius (fraction of min-dim) where printed detail collapses onto shellac.

    Returns ``None`` unless the profile both (a) peaks somewhere plausible for a
    label and (b) drops below ``_TEX_ALPHA`` of that peak and STAYS there all the
    way out to ``_TEX_QUIET_TO``. The "stays there" half is what distinguishes a
    disc's wide shellac ring from a label scan that merely darkens at the corners.
    """
    prof = _texture_profile(work)
    step = _TEX_PROF_RMAX / _TEX_NBINS
    inner = prof[int(0.03 / step):int(0.40 / step)]
    if np.all(np.isnan(inner)):
        return None
    peak = float(np.nanmax(inner))
    if peak < _TEX_MIN_PEAK:
        return None
    quiet_end = int(_TEX_QUIET_TO / step)
    for i in range(int(_TEX_RMIN / step), int(_TEX_RMAX / step) + 1):
        r = (i + 0.5) * step
        # the quiet band has to be a disc's ring, not a close-up's margin
        if _TEX_QUIET_TO < r * _TEX_MIN_RING_RATIO:
            continue
        tail = prof[i:quiet_end]
        tail = tail[~np.isnan(tail)]
        if tail.size and bool(np.all(tail < _TEX_ALPHA * peak)):
            return r
    return None


def _texture_bbox(work: np.ndarray, scale: float, H: int, W: int) -> BBox | None:
    """Square crop around the centred label found by the texture collapse."""
    rfrac = _texture_label_radius(work)
    if rfrac is None:
        return None
    h, w = work.shape[:2]
    half = rfrac * float(min(h, w)) * (1.0 + CROP_MARGIN)
    cx, cy = w / 2.0, h / 2.0
    left = max(0, int(round((cx - half) / scale)))
    top = max(0, int(round((cy - half) / scale)))
    right = min(W, int(round((cx + half) / scale)))
    bottom = min(H, int(round((cy + half) / scale)))
    if right - left < 8 or bottom - top < 8:
        return None
    return left, top, right, bottom


def _shellac_reaches_out(V: np.ndarray, S: np.ndarray,
                         cx: float, cy: float, r: float) -> bool:
    """True when dark, desaturated shellac still surrounds the circle far out.

    The guards in _full_disc_bbox only probe out to ~2.2r, which on a label-only
    scan can sit entirely inside the label -- dark printed ink there reads as
    shellac and the candidate passes (measured: dark_frac 0.94, 12/12 sectors).
    A real full-disc photo keeps its shellac out to ~3r, and shellac is both
    dark AND desaturated, which ink over paper is not. Requiring the band to
    survive that far is what separates the two cases.

    Returns False when the band would fall outside the frame: unprovable is
    treated as unproven, because a wrong crop is worse than no crop.
    """
    h, w = V.shape
    mind = float(min(h, w))
    r_in, r_out = r * _REACH_FROM, min(r * _REACH_OUT, _REACH_MAX_FRAC * mind)
    if r_out <= r_in:
        return False
    dark_frac, _ = _ring_dark_fraction(V, cx, cy, r_in, r_out)
    if dark_frac < _REACH_DARK:
        return False
    if _dark_sector_count(V, cx, cy, r_in, r_out) < _MIN_DARK_SECTORS:
        return False
    yy, xx = np.mgrid[0:h, 0:w]
    rr = np.hypot(xx - cx, yy - cy)
    band = (rr >= r_in) & (rr <= r_out)
    return bool(band.sum()) and float(S[band].mean()) < _REACH_SAT


def _hough_label_circles(work: np.ndarray) -> list[tuple[float, float, float, float]]:
    """Label-circle candidates from a Hough transform, best accumulator first.

    The colour and texture paths both locate the label as a *region*: a bright
    island owning the frame centre, or a collapse in print texture around it.
    Both assume the disc is roughly centred and reasonably large. A marketplace
    photo often satisfies neither -- the disc sits off to one side, or fills a
    small part of a wide shot -- so the label lands under _FULL_MIN_RFRAC or
    outside _MAX_CENTER_OFF, nothing is returned, and the caller hands the
    vision pass an uncropped frame with a label a few hundred pixels across.

    Hough finds a circle by its EDGE, so neither centring nor size matters.
    This is deliberately only a candidate generator: the caller vets every
    circle through _full_disc_bbox, which demands the dark shellac ring, the
    sector wrap and the label/ring contrast. That is what keeps rule 1 of this
    module intact -- a label-only scan must never come back 'full_disc' --
    because a scan with no surrounding shellac cannot clear those guards no
    matter what circle Hough proposes.

    ``fill`` is reported as 1.0: a Hough circle is circular by construction,
    which is the one property ``fill`` exists to measure.
    """
    gray = cv2.cvtColor(work, cv2.COLOR_BGR2GRAY)
    gray = cv2.medianBlur(gray, 5)
    mind = float(min(gray.shape[:2]))
    found = cv2.HoughCircles(
        gray, cv2.HOUGH_GRADIENT, dp=1.0, minDist=mind * 0.25,
        param1=_HOUGH_EDGE, param2=_HOUGH_ACC,
        minRadius=int(mind * _HOUGH_MIN_RFRAC),
        maxRadius=int(mind * _HOUGH_MAX_RFRAC),
    )
    if found is None:
        return []
    return [(float(c[0]), float(c[1]), float(c[2]), 1.0)
            for c in found[0][:_HOUGH_MAX_CANDIDATES]]


def classify_and_detect(img) -> tuple[Verdict, BBox | None]:
    """Classify a record image and, for 'full_disc', return the label crop box.

    Returns ``(verdict, bbox)`` where ``verdict`` is 'full_disc', 'label_only' or
    'unknown', and ``bbox`` is ``(left, top, right, bottom)`` in original-image
    pixels (a square around the label with ~4% margin) only for 'full_disc';
    ``None`` otherwise.
    """
    bgr = _to_bgr(img)
    H, W = bgr.shape[:2]
    work, scale = _downscale(bgr)
    hsv = cv2.cvtColor(work, cv2.COLOR_BGR2HSV)
    V = hsv[:, :, 2].astype(np.float32)
    S = hsv[:, :, 1].astype(np.float32)
    h, w = V.shape
    mind = float(min(h, w))
    sigma = max(1.0, mind * 0.012)

    # labelness: a label pixel is bright (paper/cream) OR saturated (coloured ink);
    # shellac is dark AND desaturated, so it stays low here.
    L = np.maximum(V, S)
    Lb = cv2.GaussianBlur(L, (0, 0), sigma)

    # whole frame dark & low-contrast -> a dark label we can't localise by colour.
    # The texture path does not read colour at all, so it gets its chance first.
    if float(np.median(Lb)) < _FLAT_DARK_V and float(Lb.std()) < 28:
        bbox = _texture_bbox(work, scale, H, W)
        return ("full_disc", bbox) if bbox is not None else ("unknown", None)

    # primary path: the label owns the frame centre in the plain labelness map.
    comp = _central_component(_binarise(Lb, 55.0))
    circle = _label_circle(comp) if comp is not None else None
    if circle is not None:
        # A tuned full_disc from the colour path wins outright.
        if circle[2] / mind < _LABEL_ONLY_RFRAC:
            bbox = _full_disc_bbox(V, S, circle, scale, H, W)
            if bbox is not None:
                return "full_disc", bbox
        else:
            # The component fills the frame, which usually means a label-only
            # scan -- but it is also what a full disc looks like when a glare
            # band bridges the label into the shellac and inflates the
            # component. Only a texture collapse, which glare cannot fake,
            # is allowed to overturn it.
            bbox = _texture_bbox(work, scale, H, W)
            return ("full_disc", bbox) if bbox is not None else ("label_only", None)

    # The primary map reached no verdict. Retry the *full-disc* analysis only, on
    # backdrop-aware maps: this rescues discs shot on a light surround, where the
    # backdrop hijacks Otsu and the label never enters the primary mask. Border
    # components are rejected here (the label of a full-disc photo cannot run off
    # the frame) and every corroboration guard still applies, so this can only
    # turn an 'unknown' into a 'full_disc' that already passed the full bar.
    for alt, floor in _alt_label_maps(V, S, Lb, sigma):
        comp = _central_component(_binarise(alt, floor), reject_border=True)
        if comp is None:
            continue
        circle = _label_circle(comp)
        if circle is None:
            continue
        bbox = _full_disc_bbox(V, S, circle, scale, H, W, _ALT_MAX_RFRAC)
        if bbox is not None:
            return "full_disc", bbox

    # Last resort: no colour map could find the label. This is the dark-label
    # case the module docstring describes, and the only path that reads it.
    bbox = _texture_bbox(work, scale, H, W)
    if bbox is not None:
        return "full_disc", bbox

    # Every region-based path has now failed, and returning 'unknown' costs the
    # caller the crop outright. Edge-based candidates get the last word, held to
    # exactly the same corroboration bar.
    for circle in _hough_label_circles(work):
        if not _shellac_reaches_out(V, S, circle[0], circle[1], circle[2]):
            continue
        bbox = _full_disc_bbox(V, S, circle, scale, H, W,
                               max_rfrac=_HOUGH_MAX_RFRAC,
                               min_rfrac=_HOUGH_MIN_RFRAC,
                               max_center_off=_HOUGH_CENTER_OFF)
        if bbox is not None:
            return "full_disc", bbox

    return "unknown", None


def _disk_mask(h: int, w: int, cx: float, cy: float, r: float) -> np.ndarray:
    yy, xx = np.mgrid[0:h, 0:w]
    return np.hypot(xx - cx, yy - cy) <= r


def crop_to_label(img: Image.Image, bbox) -> Image.Image:
    """Crop a PIL image to the given ``(left, top, right, bottom)`` box."""
    return img.crop(bbox)
